{
  "name": "xmltodict",
  "version": "1.0.5",
  "description": "Bidirectional XML <-> JS object conversion compatible with Python xmltodict",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "require": "./src/index.js",
      "import": "./src/index.mjs",
      "types": "./src/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "xmltodict": "bin/xmltodict.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync:upstream": "node ./scripts/sync-upstream.mjs",
    "test": "node --test ./test/compat/*.test.js ./test/unit/*.test.js ./test/cli/*.test.js",
    "test:unit": "node --test ./test/unit/*.test.js",
    "test:compat": "node --test ./test/compat/*.test.js",
    "test:cli": "node --test ./test/cli/*.test.js",
    "dev:verify:real-world-samples": "node ./scripts/verify-real-world-samples.mjs",
    "smoke:python": "python3 ./test/helpers/python_oracle.py smoke",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "xml",
    "json",
    "parser",
    "serializer",
    "xmltodict",
    "xml-to-json",
    "json-to-xml",
    "xml-to-js",
    "js-to-xml",
    "xml-to-object",
    "object-to-xml",
    "bidirectional",
    "python-compatibility",
    "xml-parser"
  ],
  "engines": {
    "node": ">=24"
  },
  "author": "Nan LI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linancn/xmltodict.git"
  },
  "homepage": "https://github.com/linancn/xmltodict#readme",
  "bugs": {
    "url": "https://github.com/linancn/xmltodict/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "saxes": "^6.0.0"
  }
}
